# AWS SNS Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials

EXPO_PUBLIC_AWS_REGION=eu-north-1
EXPO_PUBLIC_AWS_ACCESS_KEY_ID=your_access_key_here
EXPO_PUBLIC_AWS_SECRET_ACCESS_KEY=your_secret_key_here
EXPO_PUBLIC_AWS_SNS_PLATFORM_ARN=arn:aws:sns:eu-north-1:828043587172:app/APNS/OutixRacer-ios
